---
import "../styles/global.css";

interface Props {
  title?: string;
  showNav?: boolean;
}

const { title = "管理画面", showNav = true } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}｜コレカラボ 管理画面</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-svh bg-ink/[0.02] antialiased">
    <header class="sticky top-0 z-40 flex items-center justify-between border-b border-ink/5 bg-white px-6 py-4">
      <a href="/admin" class="font-display font-bold text-ink">
        コレカラボ<span class="text-turquoise-deep">管理画面</span>
      </a>
      {
        showNav && (
          <nav class="flex items-center gap-4 text-sm font-bold text-ink-soft">
            <a href="/admin/posts" class="transition-colors hover:text-turquoise-deep">
              ブログ記事
            </a>
            <a href="/admin/news" class="transition-colors hover:text-turquoise-deep">
              お知らせ
            </a>
            <a href="/admin/services" class="transition-colors hover:text-turquoise-deep">
              サービス
            </a>
            <a href="/" class="transition-colors hover:text-turquoise-deep">
              サイトを見る
            </a>
            <form method="POST" action="/admin/logout">
              <button
                type="submit"
                class="rounded-full bg-ink/5 px-4 py-2 font-bold text-ink-soft transition-colors hover:bg-ink/10"
              >
                ログアウト
              </button>
            </form>
          </nav>
        )
      }
    </header>
    <main class="mx-auto max-w-6xl px-6 py-10">
      <slot />
    </main>
    <script>
      document.addEventListener("submit", (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        const message = form.getAttribute("data-confirm");
        if (message && !window.confirm(message)) {
          event.preventDefault();
        }
      });
    </script>
  </body>
</html>
