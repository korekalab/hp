---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import AdminEditorScript from "../../../../components/admin/AdminEditorScript.astro";
import EyecatchUploader from "../../../../components/admin/EyecatchUploader.astro";
import { CATEGORY_IDS, CATEGORY_LABEL } from "../../../../lib/categories";
import { getPostById } from "../../../../lib/db";

export const prerender = false;

const id = Number(Astro.params.id);
const post = Number.isFinite(id) ? await getPostById(env.DB, id) : null;

if (!post) {
  return Astro.redirect("/admin/posts");
}
---

<AdminLayout title="記事を編集">
  <h1 class="font-display text-2xl font-black text-ink">記事を編集</h1>

  <form id="post-form" class="mt-8 space-y-6">
    <div>
      <label for="title" class="text-sm font-bold text-ink">タイトル</label>
      <input
        type="text"
        id="title"
        name="title"
        required
        value={post.title}
        class="mt-1 w-full rounded-xl border border-ink/10 px-4 py-2.5 outline-none focus:border-turquoise-deep"
      />
    </div>

    <div>
      <label for="slug" class="text-sm font-bold text-ink">リンク(スラッグ)</label>
      <div class="mt-1 flex items-center gap-2 text-sm text-ink-soft">
        <span>/blog/</span>
        <input
          type="text"
          id="slug"
          name="slug"
          required
          value={post.slug}
          class="w-full rounded-xl border border-ink/10 px-4 py-2.5 text-ink outline-none focus:border-turquoise-deep"
        />
      </div>
    </div>

    <div>
      <label for="category" class="text-sm font-bold text-ink">カテゴリ</label>
      <select
        id="category"
        name="category"
        required
        class="mt-1 w-full rounded-xl border border-ink/10 px-4 py-2.5 outline-none focus:border-turquoise-deep"
      >
        {
          CATEGORY_IDS.map((id) => (
            <option value={id} selected={id === post.category}>
              {CATEGORY_LABEL[id]}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label for="meta_description" class="text-sm font-bold text-ink">メタディスクリプション(SEO用)</label>
      <textarea
        id="meta_description"
        name="meta_description"
        rows="3"
        maxlength="160"
        placeholder="検索結果に表示される説明文です。空欄の場合は本文から自動生成されます。"
        class="mt-1 w-full rounded-xl border border-ink/10 px-4 py-2.5 outline-none focus:border-turquoise-deep"
        set:text={post.meta_description ?? ""}
      />
      <p class="mt-1 text-xs text-ink-soft/70">
        <span id="meta-description-count">{(post.meta_description ?? "").length}</span>/160文字。Google検索結果の説明文として使われます。
      </p>
    </div>

    <div>
      <span class="text-sm font-bold text-ink">アイキャッチ画像</span>
      <div class="mt-2">
        <EyecatchUploader initialUrl={post.eyecatch_url} />
      </div>
    </div>

    <div>
      <span class="text-sm font-bold text-ink">本文</span>
      <div class="mt-2">
        <AdminEditorScript id="content" initialHtml={post.content_html} />
      </div>
    </div>

    <label class="flex items-center gap-2 text-sm font-bold text-ink">
      <input
        type="checkbox"
        id="published"
        name="published"
        checked={post.published === 1}
        class="h-4 w-4 rounded border-ink/20 text-turquoise-deep focus:ring-turquoise-deep"
      />
      公開する
    </label>

    <p id="form-error" class="hidden rounded-xl bg-red-50 px-4 py-3 text-sm font-bold text-red-600"></p>

    <div class="flex items-center gap-3">
      <button
        type="submit"
        class="rounded-full bg-turquoise-deep px-6 py-3 font-display font-bold text-white transition-colors hover:bg-ink"
      >
        更新する
      </button>
      <a
        href="/admin/posts"
        class="rounded-full bg-ink/5 px-6 py-3 text-sm font-bold text-ink-soft transition-colors hover:bg-ink/10"
      >
        キャンセル
      </a>
    </div>
  </form>
</AdminLayout>

<script is:inline define:vars={{ postId: post.id }}>
  window.__POST_ID__ = postId;
</script>
<script>
  import { slugify } from "../../../../lib/slugify";

  const titleInput = document.getElementById("title") as HTMLInputElement | null;
  const slugInput = document.getElementById("slug") as HTMLInputElement | null;
  let slugTouched = true; // 編集時は既存スラッグを尊重し、自動上書きしない

  slugInput?.addEventListener("input", () => {
    slugTouched = true;
  });
  titleInput?.addEventListener("input", () => {
    if (!slugTouched && slugInput) slugInput.value = slugify(titleInput.value);
  });

  const metaDescriptionInput = document.getElementById("meta_description") as HTMLTextAreaElement | null;
  const metaDescriptionCount = document.getElementById("meta-description-count");
  metaDescriptionInput?.addEventListener("input", () => {
    if (metaDescriptionCount) metaDescriptionCount.textContent = String(metaDescriptionInput.value.length);
  });

  const form = document.getElementById("post-form") as HTMLFormElement | null;
  const errorEl = document.getElementById("form-error");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl?.classList.add("hidden");

    const formData = new FormData(form);
    const contentHtml = (window as any).__adminEditors?.content?.getHTML() ?? "";

    const payload = {
      title: formData.get("title"),
      slug: formData.get("slug"),
      category: formData.get("category"),
      meta_description: formData.get("meta_description") || null,
      eyecatch_url: formData.get("eyecatch_url") || null,
      content_html: contentHtml,
      published: formData.get("published") === "on",
    };

    const res = await fetch(`/api/admin/posts/${(window as any).__POST_ID__}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      window.location.href = "/admin/posts";
    } else {
      const data = (await res.json().catch(() => ({}))) as { error?: string };
      if (errorEl) {
        errorEl.textContent = data.error || "更新に失敗しました。";
        errorEl.classList.remove("hidden");
      }
    }
  });
</script>
