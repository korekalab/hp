---
import { env } from "cloudflare:workers";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { listAllServices } from "../../../lib/db";
import { getProjectCategory } from "../../../data/projects";

export const prerender = false;

const services = await listAllServices(env.DB);
---

<AdminLayout title="サービス">
  <div class="flex items-center justify-between">
    <h1 class="font-display text-2xl font-black text-ink">サービス(今、やっていること)</h1>
    <a
      href="/admin/services/new"
      class="rounded-full bg-turquoise-deep px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-ink"
    >
      + 新規作成
    </a>
  </div>
  <p class="mt-2 text-sm text-ink-soft">
    トップページ「今、やっていること」の各ジャンルをクリックした先(<code>/works/[ジャンル]</code>)に表示されるサービス一覧です。
  </p>

  <div class="mt-8 overflow-hidden rounded-3xl border border-ink/5 bg-white">
    {
      services.length === 0 ? (
        <p class="p-8 text-center text-ink-soft">まだサービスがありません。</p>
      ) : (
        <table class="w-full text-left text-sm">
          <thead class="border-b border-ink/5 bg-ink/[0.02] text-xs font-bold text-ink-soft">
            <tr>
              <th class="px-5 py-3">サービス名</th>
              <th class="px-5 py-3">ジャンル</th>
              <th class="px-5 py-3">状態</th>
              <th class="px-5 py-3" />
            </tr>
          </thead>
          <tbody class="divide-y divide-ink/5">
            {services.map((service) => (
              <tr>
                <td class="px-5 py-3 font-bold text-ink">{service.name}</td>
                <td class="px-5 py-3 text-ink-soft">{getProjectCategory(service.category).label}</td>
                <td class="px-5 py-3">
                  <span
                    class={
                      service.published
                        ? "rounded-full bg-turquoise/10 px-3 py-1 text-xs font-bold text-turquoise-deep"
                        : "rounded-full bg-ink/5 px-3 py-1 text-xs font-bold text-ink-soft"
                    }
                  >
                    {service.published ? "公開中" : "下書き"}
                  </span>
                </td>
                <td class="px-5 py-3">
                  <div class="flex items-center justify-end gap-2">
                    <a
                      href={`/admin/services/${service.id}/edit`}
                      class="rounded-full bg-ink/5 px-3 py-1.5 text-xs font-bold text-ink-soft transition-colors hover:bg-ink/10"
                    >
                      編集
                    </a>
                    <form method="POST" action={`/api/admin/services/${service.id}/toggle`}>
                      <button
                        type="submit"
                        class="rounded-full bg-ink/5 px-3 py-1.5 text-xs font-bold text-ink-soft transition-colors hover:bg-turquoise/10"
                      >
                        {service.published ? "非公開にする" : "公開する"}
                      </button>
                    </form>
                    <form
                      method="POST"
                      action={`/api/admin/services/${service.id}/delete`}
                      data-confirm="このサービスを削除しますか？"
                    >
                      <button
                        type="submit"
                        class="rounded-full bg-ink/5 px-3 py-1.5 text-xs font-bold text-ink-soft transition-colors hover:bg-red-50 hover:text-red-600"
                      >
                        削除
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </div>
</AdminLayout>
