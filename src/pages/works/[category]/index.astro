---
import { env } from "cloudflare:workers";
import PageLayout from "../../../layouts/PageLayout.astro";
import ServiceCard from "../../../components/works/ServiceCard.astro";
import { listPublishedServicesByCategory } from "../../../lib/db";
import { isProjectCategoryId, getProjectCategory } from "../../../data/projects";

const categoryParam = Astro.params.category;
if (!isProjectCategoryId(categoryParam)) {
  return Astro.rewrite("/404");
}

const category = getProjectCategory(categoryParam);
const services = await listPublishedServicesByCategory(env.DB, categoryParam);
---

<PageLayout title={`${category.label}｜コレカラボ`} description={category.description}>
  <section class="px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="text-center">
        <p class="font-display text-sm font-bold tracking-[0.3em] text-turquoise-deep">{category.labelEn}</p>
        <h1 class="mt-4 font-display text-3xl font-black text-balance text-ink sm:text-4xl">{category.label}</h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-ink-soft sm:text-base">
          {category.description}
        </p>
      </div>

      <div class="mt-12">
        {
          services.length === 0 ? (
            <p class="rounded-3xl border-2 border-dashed border-turquoise/30 bg-turquoise/5 px-8 py-16 text-center text-ink-soft">
              ここには、これからいろいろ増えていきます。
            </p>
          ) : (
            <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
              {services.map((service) => (
                <ServiceCard service={service} />
              ))}
            </div>
          )
        }
      </div>

      <div class="mt-14 text-center">
        <a
          href="/#projects"
          class="inline-block rounded-full bg-ink/5 px-6 py-3 text-sm font-bold text-ink-soft transition-colors hover:bg-turquoise/10"
        >
          ← 一覧に戻る
        </a>
      </div>
    </div>
  </section>
</PageLayout>
