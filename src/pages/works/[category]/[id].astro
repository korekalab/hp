---
import { env } from "cloudflare:workers";
import PageLayout from "../../../layouts/PageLayout.astro";
import { getServiceById } from "../../../lib/db";
import { isProjectCategoryId, getProjectCategory } from "../../../data/projects";

const categoryParam = Astro.params.category;
const idParam = Number(Astro.params.id);

if (!isProjectCategoryId(categoryParam) || !Number.isFinite(idParam)) {
  return Astro.rewrite("/404");
}

const service = await getServiceById(env.DB, idParam);
if (!service || service.published !== 1 || service.category !== categoryParam) {
  return Astro.rewrite("/404");
}

const category = getProjectCategory(categoryParam);
---

<PageLayout title={`${service.name}｜コレカラボ`} description={service.description.slice(0, 120)}>
  <article class="px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl">
      <p class="text-center">
        <span class="inline-block rounded-full bg-turquoise/10 px-3 py-1 text-xs font-bold text-turquoise-deep">
          {category.label}
        </span>
      </p>
      <h1 class="mt-4 text-center font-display text-2xl font-black text-balance text-ink sm:text-3xl md:text-4xl">
        {service.name}
      </h1>

      {
        service.eyecatch_url &&
          (service.url ? (
            <a
              href={service.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 block aspect-video overflow-hidden rounded-3xl bg-ink/5"
            >
              <img
                src={service.eyecatch_url}
                alt=""
                class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
              />
            </a>
          ) : (
            <div class="mt-8 aspect-video overflow-hidden rounded-3xl bg-ink/5">
              <img src={service.eyecatch_url} alt="" class="h-full w-full object-cover" />
            </div>
          ))
      }

      <div class="mt-10 whitespace-pre-line text-base leading-loose text-ink-soft">{service.description}</div>

      {
        service.url && (
          <p class="mt-8 text-center">
            <a
              href={service.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-turquoise-deep px-6 py-3 font-display font-bold text-white transition-colors hover:bg-ink"
            >
              サービスを見る ↗
            </a>
          </p>
        )
      }

      <div class="mt-14 text-center">
        <a
          href={`/works/${category.id}`}
          class="inline-block rounded-full bg-ink/5 px-6 py-3 text-sm font-bold text-ink-soft transition-colors hover:bg-turquoise/10"
        >
          ← 一覧に戻る
        </a>
      </div>
    </div>
  </article>
</PageLayout>
