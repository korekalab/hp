---
import { env } from "cloudflare:workers";
import PageLayout from "../../layouts/PageLayout.astro";
import NewsAccordionItem from "../../components/news/NewsAccordionItem.astro";
import { listPublishedNews } from "../../lib/db";

const items = await listPublishedNews(env.DB);
---

<PageLayout title="お知らせ｜コレカラボ" description="コレカラボからのお知らせ一覧です。">
  <section class="px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl">
      <div class="text-center">
        <h1 class="font-display text-3xl font-black text-balance text-ink sm:text-4xl">お知らせ</h1>
      </div>

      <div class="mt-12 space-y-4">
        {
          items.length === 0 ? (
            <p class="rounded-3xl border-2 border-dashed border-turquoise/30 bg-turquoise/5 px-8 py-16 text-center text-ink-soft">
              まだお知らせがありません。
            </p>
          ) : (
            items.map((item) => <NewsAccordionItem item={item} />)
          )
        }
      </div>
    </div>
  </section>
</PageLayout>
