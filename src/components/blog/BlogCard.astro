---
import type { Post } from "../../lib/db";
import { CATEGORY_LABEL } from "../../lib/categories";

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<a
  href={`/blog/${post.slug}`}
  class="group block overflow-hidden rounded-3xl border border-ink/5 bg-white shadow-sm transition-shadow hover:shadow-lg"
>
  <div class="aspect-video overflow-hidden bg-ink/5">
    <img
      src={post.eyecatch_url ?? "/logo-mark.png"}
      alt=""
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="p-5">
    <span class="inline-block rounded-full bg-turquoise/10 px-3 py-1 text-xs font-bold text-turquoise-deep">
      {CATEGORY_LABEL[post.category]}
    </span>
    <h3 class="mt-3 line-clamp-2 font-display text-lg font-bold text-ink">{post.title}</h3>
    <p class="mt-2 line-clamp-3 text-sm text-ink-soft">{post.excerpt}</p>
  </div>
</a>
