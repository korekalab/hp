---
import type { Post } from "../../lib/db";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <aside class="rounded-3xl border border-ink/5 bg-white p-6">
      <h2 class="font-display text-sm font-bold tracking-wide text-ink-soft">人気の記事</h2>
      <ul class="mt-4 space-y-3">
        {posts.map((post, i) => (
          <li>
            <a
              href={`/blog/${post.slug}`}
              class="flex items-center gap-3 rounded-2xl p-2 transition-colors hover:bg-turquoise/5"
            >
              <span class="font-display text-xl font-black text-turquoise-deep">{i + 1}</span>
              <span class="line-clamp-2 text-sm font-bold text-ink">{post.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
