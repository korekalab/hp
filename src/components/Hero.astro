---
import { SITE } from "../data/site";
---

<section
  id="hero"
  class="relative flex min-h-svh flex-col items-center justify-center overflow-hidden px-6 pt-24 pb-16 text-center"
>
  <!-- 背景の浮遊する丸 -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="animate-float absolute -left-24 -top-16 h-72 w-72 rounded-full bg-turquoise/20 blur-2xl sm:h-96 sm:w-96"
    >
    </div>
    <div
      class="animate-float absolute -right-20 top-1/3 h-56 w-56 rounded-full bg-sunshine/25 blur-2xl [animation-delay:1.4s] sm:h-80 sm:w-80"
    >
    </div>
    <div
      class="animate-float absolute -bottom-24 left-1/4 h-64 w-64 rounded-full bg-turquoise-light/20 blur-2xl [animation-delay:2.6s]"
    >
    </div>
  </div>

  <div class="relative z-10 flex flex-col items-center">
    <img
      src="/logo-mark.png"
      width="96"
      height="96"
      alt={SITE.name}
      class="animate-pop mb-6 h-20 w-20 sm:h-24 sm:w-24"
    />

    <h1 class="font-display text-4xl font-black leading-[1.35] text-ink sm:text-6xl sm:leading-[1.3] md:text-7xl">
      <span class="sm:hidden">
        <span class="text-turquoise-deep">「これか！」</span>と<br />
        思ったら、<br />
        やってみる。
      </span>
      <span class="hidden sm:inline">
        <span class="text-turquoise-deep">「これか！」</span>と思ったら、<br />
        やってみる。
      </span>
    </h1>

    <p class="mt-6 text-base leading-relaxed text-ink-soft sm:text-lg md:text-xl">
      面白そう。<br class="sm:hidden" />
      その直感から、これからをつくる。
    </p>
  </div>

  <a
    href="#about"
    class="group absolute bottom-8 z-10 flex flex-col items-center gap-2 text-xs font-bold tracking-[0.2em] text-ink-soft/70 transition-colors hover:text-turquoise-deep"
    aria-label="次のセクションへスクロール"
  >
    <span>SCROLL</span>
    <svg
      class="h-5 w-5 animate-bounce"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 4v16M6 14l6 6 6-6" />
    </svg>
  </a>
</section>
