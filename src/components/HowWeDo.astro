---
import { flowSteps } from "../data/flow";

const dotColors = ["bg-turquoise", "bg-turquoise-light", "bg-sunshine", "bg-sunshine-deep", "bg-turquoise-deep"];
---

<section id="how" class="relative overflow-hidden px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-5xl text-center">
    <h2 data-reveal class="font-display text-3xl font-black text-balance text-ink sm:text-4xl">やり方はシンプル。</h2>
    <p data-reveal class="mt-3 text-ink-soft">思いついたら、考える前に、動く。</p>

    <div
      class="mt-16 flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between sm:gap-2"
    >
      {
        flowSteps.map((step, i) => (
          <>
            <div
              data-reveal
              style={`transition-delay:${i * 100}ms`}
              class="flex flex-1 flex-col items-center gap-3 rounded-2xl px-2 py-4 transition-transform duration-300 hover:-translate-y-1"
            >
              <div
                class={`flex h-16 w-16 items-center justify-center rounded-full ${dotColors[i]} font-display text-xl font-black text-white shadow-md`}
              >
                {step.number}
              </div>
              <p class="font-display text-lg font-bold text-ink">{step.title}</p>
              <p class="text-sm leading-relaxed text-ink-soft">{step.description}</p>
            </div>
            {i < flowSteps.length - 1 && (
              <div class="flex items-center justify-center text-turquoise/40 sm:pt-6" aria-hidden="true">
                <svg
                  class="h-6 w-6 rotate-90 sm:rotate-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </div>
            )}
          </>
        ))
      }
    </div>
  </div>
</section>
