---
import { SITE } from "../data/site";
---

<header
  class="fixed top-0 inset-x-0 z-50 flex items-center justify-between px-5 py-3 sm:px-8 sm:py-4 bg-white/75 backdrop-blur-md border-b border-ink/5"
>
  <a href="#hero" class="flex items-center gap-2 group" aria-label={`${SITE.name} トップへ`}>
    <img
      src="/logo-mark.png"
      width="36"
      height="36"
      alt=""
      class="rounded-full transition-transform duration-300 group-hover:rotate-12"
    />
    <span class="font-display font-bold text-ink text-lg tracking-wide">{SITE.name}</span>
  </a>
  <a
    href="#contact"
    class="rounded-full bg-ink text-white text-sm font-bold px-4 py-2 sm:px-5 sm:py-2.5 transition-colors hover:bg-turquoise-deep"
  >
    お問い合わせ
  </a>
</header>
