---
import type { News } from "../../lib/db";

interface Props {
  item: News;
}

const { item } = Astro.props;
---

<details class="group rounded-3xl border border-ink/5 bg-white p-5 open:shadow-md">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display font-bold text-ink">
    <span>{item.title}</span>
    <svg
      class="h-5 w-5 shrink-0 text-turquoise-deep transition-transform duration-300 group-open:rotate-180"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M6 9l6 6 6-6" />
    </svg>
  </summary>
  <div class="prose-blog mt-4 text-sm" set:html={item.body_html} />
</details>
