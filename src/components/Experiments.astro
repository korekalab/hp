---
import { experiments, EXPERIMENT_STATUS_LABEL, type ExperimentStatus } from "../data/experiments";

const statusStyle: Record<ExperimentStatus, string> = {
  developing: "bg-sunshine/20 text-sunshine-deep",
  released: "bg-turquoise/15 text-turquoise-deep",
  testing: "bg-turquoise-light/15 text-turquoise-deep",
  closed: "bg-ink/10 text-ink-soft",
};
---

<section id="experiments" class="relative overflow-hidden px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-4xl text-center">
    <p data-reveal class="font-display text-sm font-bold tracking-[0.3em] text-turquoise-deep">
      EXPERIMENTS
    </p>
    <h2 data-reveal class="mt-4 font-display text-3xl font-black text-balance text-ink sm:text-4xl">実験中。</h2>
    <p data-reveal class="mt-3 text-ink-soft">
      開発中・公開済み・検証中・終了。<br />
      失敗も含めて、実験の履歴として残していきます。
    </p>

    {
      experiments.length === 0 ? (
        <div
          data-reveal
          class="mt-14 rounded-3xl border-2 border-dashed border-turquoise/30 bg-turquoise/5 px-8 py-16"
        >
          <p class="font-display text-lg font-bold text-ink">
            ここには、これからいろいろ増えていきます。
          </p>
          <p class="mt-2 text-sm text-ink-soft">お楽しみに。</p>
        </div>
      ) : (
        <ul class="mt-14 grid grid-cols-1 gap-4 text-left sm:grid-cols-2">
          {experiments.map((exp, i) => (
            <li
              data-reveal
              style={`transition-delay:${(i % 4) * 80}ms`}
              class="rounded-2xl border border-ink/5 bg-white p-5 shadow-sm"
            >
              <div class="flex items-center justify-between gap-3">
                <p class="font-display font-bold text-ink">{exp.name}</p>
                <span class={`shrink-0 rounded-full px-3 py-1 text-xs font-bold ${statusStyle[exp.status]}`}>
                  {EXPERIMENT_STATUS_LABEL[exp.status]}
                </span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{exp.description}</p>
              {exp.url && (
                <a href={exp.url} class="mt-3 inline-block text-sm font-bold text-turquoise-deep hover:underline">
                  詳しく見る →
                </a>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
